rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@baluarte.gov.ph' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['SuperAdmin', 'Captain']))
      );
    }

    // 1. Users Collection
    match /users/{userId} {
      // Authenticated users can read user profiles (necessary for profile sync & admin rosters)
      allow read: if isSignedIn();
      // Users can write their own profile document on sign-up, or admins can manage
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Residents Collection
    match /residents/{residentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // 3. Households Collection
    match /households/{householdId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 4. Document Requests
    match /requests/{requestId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 5. Blotter Records
    match /blotter/{recordId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 6. Treasury Logs
    match /treasury/{logId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 7. Health Records
    match /health_records/{recordId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 8. Case History
    match /case_history/{historyId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 9. Katarungang Pambarangay Cases
    match /cases/{caseId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 10. DRRM Incidents & Evacuation Operations
    match /drrm_incidents/{incidentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 11. Youth & SK Programs
    match /youth_programs/{programId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 12. Administrative Audit Trail
    match /audit_trail/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 13. Public Landing Pages Content
    match /landing_pages/{pageId} {
      allow read: if true; // Publicly readable for citizens
      allow write: if isSignedIn();
    }
  }
}
